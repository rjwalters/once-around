{
  "name": "once-around-web",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "cd ../../crates/sky_engine && wasm-pack build --target web --out-dir ../../apps/web/src/wasm --release",
    "build:all": "pnpm build:wasm && pnpm build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "deploy:preview": "VITE_ALIGNMENT_REPORT_ENDPOINT= pnpm build && wrangler pages deploy dist --project-name=once-around",
    "deploy:prod": "pnpm build && wrangler pages deploy dist --project-name=once-around --branch=main",
    "deploy:all": "pnpm build:all && wrangler pages deploy dist --project-name=once-around --branch=main"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.2",
    "vitest": "^3.2.4",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.6.0",
    "wrangler": "^4.144.0"
  }
}
